{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 40,
            "statusMessage": "Checking Harness MR GitLab authorization",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/session-start.ps1\""
          }
        ]
      }
    ]
  }
}
